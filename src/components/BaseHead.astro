---
import { OG_LOCALE, type Lang } from "@i18n/config"
import { localizePath } from "@i18n/paths"
import { ui } from "@i18n/ui"

interface Props {
  title: string
  description: string
  lang: Lang
  hasTwin: boolean
  image?: string
}

const { pathname } = Astro.url
const canonicalURL = new URL(pathname, Astro.site)
const alternate = (lang: Lang) => new URL(localizePath(pathname, lang), Astro.site)

const { title, description, lang, hasTwin, image = "/open-graph.jpg" } = Astro.props
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/jpeg" href="/img/favicon.jpeg" />
<meta name="generator" content={Astro.generator} />

<link rel="preload" href="/fonts/work-sans.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Versiones por idioma -->
{hasTwin && (
  <>
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="es" href={alternate("es")} />
    <link rel="alternate" hreflang="x-default" href={alternate("en")} />
  </>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title={ui[lang].meta.rssTitle} href={new URL(localizePath("/rss.xml", lang), Astro.site)}/>

<!-- Global Scripts -->
<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/scroll.js"></script>
<script is:inline src="/js/animate.js"></script>
<script defer is:inline src="/js/copy.js"></script>

