---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
import Container from "@components/Container.astro"
import LangToggle from "@components/LangToggle.astro"
import type { Lang } from "@i18n/config"
import { localizePath, pathWithoutLang } from "@i18n/paths"
import { ui } from "@i18n/ui"

interface Props {
  lang: Lang
  hasTwin: boolean
}

const { lang, hasTwin } = Astro.props
const t = ui[lang]
const pathname = pathWithoutLang(Astro.url.pathname)
const subpath = pathname.match(/[^/]+/g)
const isActive = (href: string) => pathname === href || "/" + subpath?.[0] === href
const searchHref = localizePath("/search", lang)
---

<header id="header" class="fixed top-0 w-full h-16 z-50">
  <Container size="lg">
    <div class="relative h-full w-full">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 flex gap-2 items-center">
        <a href={localizePath("/", lang)} class="flex gap-2 items-center text-current hover:text-river-deep transition-colors duration-300 ease-in-out">
          <img src="/img/favicon.jpeg" alt={t.chrome.logoAlt} class="size-6 rounded-full object-cover" />
          <div class="label text-ink">
            {SITE.TITLE}
          </div>
        </a>
      </div>

      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <nav class="hidden md:flex items-center justify-center gap-1">
          {
            LINKS.map((LINK) => {
              const external = LINK.HREF.startsWith("http")
              const active = !external && isActive(LINK.HREF)
              return (
                <a
                  href={localizePath(LINK.HREF, lang)}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class={cn(
                    "label h-8 rounded-full px-3 whitespace-nowrap",
                    "flex items-center justify-center gap-1",
                    "transition-colors duration-300 ease-in-out",
                    active
                      ? "bg-ink text-paper"
                      : "hover:bg-paper-raised hover:text-river-deep"
                  )}
                >
                  {t.nav[LINK.KEY]}
                  {external && <span aria-hidden="true">&#8599;</span>}
                </a>
              )
            })
          }
        </nav>
      </div>

      <div class="buttons absolute right-0 top-1/2 -translate-y-1/2 flex gap-1">
        {hasTwin && <LangToggle lang={lang} class="hidden md:flex" />}

        <a href={searchHref} aria-label={t.chrome.searchAria} class={cn("hidden md:flex", "size-9 rounded-full p-2 items-center justify-center", "bg-transparent hover:bg-paper-raised", "stroke-ink-faint hover:stroke-river-deep", "border border-mist", "transition-colors duration-300 ease-in-out", isActive("/search") ? "pointer-events-none bg-ink text-paper" : "")}>
          <svg class="size-full">
            <use href="/ui.svg#search"></use>
          </svg>
        </a>

        <button id="header-theme-button" aria-label={t.chrome.themeAria} class={cn("hidden md:flex", "size-9 rounded-full p-2 items-center justify-center", "bg-transparent hover:bg-paper-raised", "stroke-ink-faint hover:stroke-river-deep", "border border-mist", "transition-colors duration-300 ease-in-out")}>
          <svg class="size-full block dark:hidden">
            <use href="/ui.svg#sun"></use>
          </svg>
          <svg class="size-full hidden dark:block">
            <use href="/ui.svg#moon"></use>
          </svg>
        </button>

        <button id="header-drawer-button" aria-label={t.chrome.drawerAria} class={cn("flex md:hidden", "size-9 rounded-full p-2 items-center justify-center", "bg-transparent hover:bg-paper-raised", "stroke-ink-faint hover:stroke-river-deep", "border border-mist", "transition-colors duration-300 ease-in-out")}>
          <svg id="drawer-open" class="size-full">
            <use href="/ui.svg#menu"></use>
          </svg>
          <svg id="drawer-close" class="size-full">
            <use href="/ui.svg#x"></use>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<style>
  #header-drawer-button > #drawer-open {
    @apply block;
  }

  #header-drawer-button > #drawer-close {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-open {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-close {
    @apply block;
  }
</style>

<script is:inline>
  function toggleDrawer() {
    const drawer = document.getElementById("drawer")
    const drawerButton = document.getElementById("header-drawer-button")
    drawer?.classList.toggle("open")
    drawerButton?.classList.toggle("open")
  }

  function initializeDrawerButton() {
    const drawerButton = document.getElementById("header-drawer-button")
    drawerButton?.addEventListener("click", toggleDrawer)
  }

  document.addEventListener("astro:after-swap", initializeDrawerButton)
  initializeDrawerButton()
</script>
